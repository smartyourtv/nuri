<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SCAFFOLD permissions only. Each gated feature adds its own permission
         WITH its permission check (pre-build audit rule). Do not pre-add
         RECORD_AUDIO / BLUETOOTH / location here — they arrive with the
         gated voice / Bluetooth / safety work, audited. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".NuriApplication"
        android:allowBackup="false"
        android:label="Nuri"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
