<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SCAFFOLD permissions only. Each gated feature adds its own permission
         WITH its permission check (pre-build audit rule). Do not pre-add
         RECORD_AUDIO / BLUETOOTH / location here — they arrive with the
         gated voice / Bluetooth / safety work, audited. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Self-update (brief §10): PackageInstaller installs require this;
         the persisted nightly job requires boot-completed; update notes post
         local notifications (runtime-granted on API 33+, recorded in-app
         regardless). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".NuriApplication"
        android:allowBackup="false"
        android:label="Nuri"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Self-update machinery (brief §10). The receiver is not exported:
             only our own install sessions can address it. -->
        <receiver
            android:name=".update.android.UpdateInstallReceiver"
            android:exported="false" />
        <service
            android:name=".update.android.NuriUpdateJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
